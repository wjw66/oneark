{
  "name": "oneark",
  "version": "0.1.0",
  "description": "OneArk 本地优先的个人资产工作台",
  "main": "./out/main/index.js",
  "author": "OneArk",
  "scripts": {
    "dev": "npm run native:build && electron-vite dev",
    "start": "electron-vite preview",
    "native:build": "node scripts/build-native.mjs",
    "native:check": "node scripts/check-rust.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src scripts tests native/package.json electron.vite.config.ts electron-builder.yml .github/workflows/verify.yml README.md",
    "format:check": "prettier --check src scripts tests native/package.json electron.vite.config.ts electron-builder.yml .github/workflows/verify.yml README.md",
    "build": "npm run native:build && npm run typecheck && electron-vite build",
    "test": "npm run build && node --test tests/native.test.cjs && node scripts/smoke-electron.mjs",
    "check": "npm run lint && npm run format:check && npm test && npm run native:check",
    "package:dir": "npm run build && electron-builder --dir",
    "package:mac": "npm run build && electron-builder --mac --arm64",
    "package:win": "npm run build && electron-builder --win --x64",
    "smoke:packaged": "node scripts/smoke-electron.mjs --packaged",
    "postinstall": "install-electron"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@napi-rs/cli": "^3.10.9",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "playwright": "^1.58.2",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.4"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11"
  }
}
